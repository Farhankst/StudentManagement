@model IEnumerable<StudentManagement.Models.Entities.Department>
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm"
             style="background: linear-gradient(90deg, #707375, #7b8080); color: white;">
            <h4 class="mb-0">Department List</h4>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm">Back</a>
        </div>
    </div>
</div>
<a class="btn btn-primary mb-3" href="@Url.Action("Create")">+ Create Department</a>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default card">
            <div class="panel-body card-body">
                <div class="dataTable_wrapper">
                    <table class="table table-bordered table-striped table-hover datatable">
                        <thead>
                            <tr>
                                <th>SL</th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int sl = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@sl</td>
                                    <td>@item.Code</td>
                                    <td>@item.Name</td>
                                    <td>@item.Description</td>
                                    <td>@(item.IsActive ? "Active" : "Inactive")</td>
                                    <td>
                                        <a class="btn btn-sm btn-warning" href="@Url.Action("Create", new { id = item.Id })">Edit</a>
                                        <a class="btn btn-sm btn-info" href="@Url.Action("Details", new { id = item.Id })">Details</a>
                                    </td>
                                </tr>
                                sl++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>